# Mesma string de conexão do worker (autenticação Windows via ODBC)
ORQ_CONN_STR=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost\SQLEXPRESS;DATABASE=RPA;Trusted_Connection=yes;TrustServerCertificate=yes;
# Usuário SQL em vez de Windows: troque Trusted_Connection=yes por UID=orq_api;PWD=troque;

# Mesmo fuso do worker: usado para calcular as próximas execuções
ORQ_FUSO=America/Sao_Paulo

# Onde a API escuta. O front (npm run dev) redireciona /api para esta porta
API_HOST=0.0.0.0
API_PORTA=3001

# Duração do login no front (horas)
API_SESSAO_HORAS=12
# Chave que assina os logins. Vazio = gerada em api\.segredo no primeiro uso.
# Com mais de um servidor de API, use o mesmo valor em todos.
API_SEGREDO=

# Tela Sobre (opcionais)
# Link do README completo (ex.: a página do README no seu Git). Vazio = botão não aparece.
ORQ_README_URL=
# Pasta ou URL do repositório pip interno, mostrada nos comandos de instalação. Vazio = pip padrão.
ORQ_PIP_REPO=
