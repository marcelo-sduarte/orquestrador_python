PORT=3001

# Mesmo fuso do worker Python (ORQ_FUSO): usado para calcular as próximas execuções
ORQ_FUSO=America/Sao_Paulo

# Opção 1 (padrão): autenticação Windows, igual ao worker Python (usa o driver ODBC + msnodesqlv8)
DB_CONN_STR=Driver={ODBC Driver 18 for SQL Server};Server=localhost\SQLEXPRESS;Database=RPA;Trusted_Connection=yes;TrustServerCertificate=yes;

# Opção 2: usuário SQL (descomente; se DB_USER estiver preenchido, a opção 1 é ignorada)
# Requer TCP/IP habilitado na instância e o serviço SQL Server Browser ligado.
# DB_SERVER=localhost
# DB_INSTANCE=SQLEXPRESS
# DB_DATABASE=RPA
# DB_USER=orq_api
# DB_PASSWORD=troque
