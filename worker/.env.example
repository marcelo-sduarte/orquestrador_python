ORQ_CONN_STR=DRIVER={ODBC Driver 18 for SQL Server};SERVER=SeuServidor;DATABASE=SeuBanco;Trusted_Connection=yes;TrustServerCertificate=yes;
ORQ_WORKER_NOME=VM-ROBOS-01
ORQ_PYTHON=C:\Python315\python.exe
ORQ_BOOTSTRAP=C:\robos\bootstrap.py
ORQ_PASTA_LOGS=C:\robos\logs
# Tags deste runner (robô com tag só roda em worker com a tag). Vazio = só robôs sem tag
ORQ_TAGS=
# A cada quantos segundos o final do log em andamento vai para o banco (o front lê de lá)
ORQ_LOG_PARCIAL_S=30
ORQ_MAX_JOBS=2
ORQ_POLL_S=5
ORQ_AGENDA_S=30
ORQ_SINAL_S=10
ORQ_ORFAO_S=120
ORQ_FUSO=America/Sao_Paulo
# Ambiente enviado ao bootstrap: DEV, QAS ou PRD
ORQ_AMBIENTE=DEV
